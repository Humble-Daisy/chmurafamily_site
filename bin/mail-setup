#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/mail-setup: configures this fork's production mail. See /docs/developer/deployment.

require "json"
require "open3"
require "rbconfig"
require "shellwords"
require "yaml"
require_relative "../lib/clean_git_env"

class MailSetup
  module CredentialsText
    def self.with_login(text, user_name:, password:)
      block = "smtp:\n  user_name: #{user_name.to_json}\n  password: #{password.to_json}\n"
      lines = text.lines
      start = lines.index { |line| line.start_with?("smtp:") }
      return "#{text.rstrip}\n\n#{block}".lstrip unless start

      stop = (start + 1...lines.size).find { |i| lines[i].match?(/\A\S/) } || lines.size
      stop -= 1 while lines[stop - 1].strip.empty?
      (lines[0...start] + [ block ] + lines[stop..]).join
    end

    def self.safe_edit?(before, after, user_name:, password:)
      old, new = [ before, after ].map { |text| YAML.unsafe_load(text) || {} }
      return false unless old.is_a?(Hash) && new.is_a?(Hash)

      new["smtp"] == { "user_name" => user_name, "password" => password } &&
        new.except("smtp") == old.except("smtp")
    rescue Psych::Exception
      false
    end
  end

  module DeployFile
    def self.values(text)
      clear = parse(text).dig("env", "clear")
      clear.is_a?(Hash) ? clear.transform_values(&:to_s) : {}
    rescue Psych::Exception, TypeError
      {}
    end

    def self.editable?(text)
      values(text).key?("SMTP_ADDRESS") && !address_index(text.lines).nil?
    end

    def self.with_values(text, values)
      lines = text.lines
      previous = address_index(lines)
      indent = lines[previous][/\A\s+/]
      values.each do |key, value|
        line = "#{indent}#{key}: #{scalar(value)}\n"
        if (found = key_index(lines, key, previous))
          lines[found] = line
          previous = found
        else
          lines.insert(previous += 1, line)
        end
      end
      lines.join
    end

    def self.safe_edit?(before, after, values)
      old = parse(before)
      new = parse(after)
      return false unless self.values(after) == self.values(before).merge(values)

      without_clear(old) == without_clear(new)
    rescue Psych::Exception, TypeError
      false
    end

    def self.parse(text)
      parsed = YAML.safe_load(text, aliases: true)
      parsed.is_a?(Hash) ? parsed : {}
    end
    private_class_method :parse

    def self.without_clear(config)
      config.merge("env" => config["env"].to_h.except("clear"))
    end
    private_class_method :without_clear

    def self.address_index(lines)
      env = lines.index { |line| line.start_with?("env:") } or return
      clear = (env + 1...lines.size).find { |i| lines[i].match?(/\A\s+clear:/) } or return
      (clear + 1...lines.size).find { |i| lines[i].match?(/\A\s+SMTP_ADDRESS:/) }
    end
    private_class_method :address_index

    def self.key_index(lines, key, from)
      (from...lines.size).find { |i| lines[i].match?(/\A\s+(# )?#{key}:/) }
    end
    private_class_method :key_index

    def self.scalar(value)
      value.match?(/\A[A-Za-z0-9][\w.@-]*\z/) ? value : value.to_json
    end
    private_class_method :scalar
  end

  # Runs as Rails' editor: stdin carries the login, and its output is discarded.
  module StandIn
    def self.run(path, input = $stdin)
      answers = JSON.parse(input.read)
      login = { user_name: answers.fetch("user_name"), password: answers.fetch("password") }
      before = File.read(path)
      after = CredentialsText.with_login(before, **login)
      return 1 unless CredentialsText.safe_edit?(before, after, **login)

      File.write(path, after)
      0
    rescue StandardError
      1
    end
  end

  class ProductionCredentials
    FILE = "config/credentials/production.yml.enc"
    PROBLEMS = {
      /ActiveSupport::MessageEncryptor::InvalidMessage/ => :wrong_key,
      /InvalidContentError|Psych::/ => :invalid_yaml
    }.freeze

    def initialize(root:, env: {})
      @root = root
      @env = env
    end

    def exists? = File.exist?(File.join(@root, FILE))

    def readable
      return :readable unless exists?

      stored
      @problem || :readable
    end

    def login?
      login = stored["smtp"]
      login.is_a?(Hash) && %w[user_name password].all? { |field| !login[field].to_s.strip.empty? }
    end

    def login_matches?(user_name:, password:)
      stored["smtp"] == { "user_name" => user_name, "password" => password }
    end

    def mailer_from
      mailer = stored["mailer"]
      mailer["from"] if mailer.is_a?(Hash)
    end

    def write_login(user_name:, password:)
      env = child_env.merge("VISUAL" => stand_in_command)
      command = %w[bin/rails credentials:edit --environment production]
      IO.popen(env, command, "w", out: File::NULL, err: File::NULL, chdir: @root) do |editor|
        editor.write(JSON.generate(user_name:, password:))
      end
      @stored = nil
      $?.success? && login_matches?(user_name:, password:)
    rescue Errno::EPIPE
      false
    end

    private

    def child_env = CleanGitEnv::HASH.merge("RAILS_CREDENTIALS_ENV" => nil).merge(@env)

    def stand_in_command
      [ RbConfig.ruby, File.join(@root, "bin/mail-setup"), "--write-login" ].map { |part| Shellwords.escape(part) }.join(" ")
    end

    def stored
      @stored ||= show
    end

    def show
      @problem = nil
      out, err, status = Open3.capture3(child_env, "bin/rails", "credentials:show", "--environment", "production", chdir: @root)
      unless status.success?
        @problem = PROBLEMS.find { |pattern, _| err.match?(pattern) }&.last || :unknown
        return {}
      end

      parsed = YAML.unsafe_load(out)
      parsed.is_a?(Hash) ? parsed : {}
    rescue Psych::Exception
      @problem = :invalid_yaml
      {}
    end
  end
end

if $PROGRAM_NAME == __FILE__
  exit MailSetup::StandIn.run(ARGV.last) if ARGV.first == "--write-login"

  abort("bin/mail-setup: not finished")
end
